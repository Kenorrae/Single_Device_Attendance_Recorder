@{
    ViewData["Title"] = "Attendance!";
    ViewData["HideNavbar"] = true;
}

<<header style="position:fixed; top:0; left:0; width:100%; text-align:center; padding:10px; background-color:#f5f5f5; z-index:1000;">
    <h1 style="font-size:2.5em; color:#333; margin:0;">Attendance!</h1>
</header>

<main style="display:flex; flex-direction:column; align-items:center; justify-content:center; height:70vh;">
    <p style="font-size:1.2em; margin-bottom:20px;">Welcome to Single Device Attendance Recorder</p>

    
    <div style="border:2px solid #ccc; border-radius:10px; padding:30px; width:300px; text-align:center; background-color:#fafafa;">
        <h3 style="margin-bottom:20px; color:#007bff;">Get Started</h3>

        <div style="display:flex; flex-direction:column; gap:15px;">
            <a asp-controller="Account" asp-action="Login"
               style="padding:10px; background-color:#007bff; color:white; text-decoration:none; border-radius:5px; display:block;">
                Login
            </a>

            <a asp-controller="Account" asp-action="Register"
               style="padding:10px; background-color:#28a745; color:white; text-decoration:none; border-radius:5px; display:block;">
                Register
            </a>
        </div>
    </div>
</main>